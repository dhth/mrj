#!/usr/bin/env bash

set -euo pipefail

remote_env_dir="$(mktemp -d)"
trap 'rm -rf "$remote_env_dir"' EXIT

git clone --depth 1 --quiet \
	https://github.com/dhth/remote-env.git \
	"$remote_env_dir"

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
install -d "$config_home/mise"
install -m 0644 \
	"$remote_env_dir/global-tools/mise.toml" \
	"$config_home/mise/config.toml"
install -m 0644 \
	"$remote_env_dir/global-tools/mise.lock" \
	"$config_home/mise/mise.lock"

"$HOME/.local/bin/mise" -C "$HOME" install --locked

cp -R "$remote_env_dir/config/." "$config_home/"
